# Copy this file to `.env` (which is gitignored) and fill in the values.
# NEVER commit real credentials.

# --- Public market data (no auth needed) ---
KALSHI_BASE_URL=https://api.elections.kalshi.com/trade-api/v2
CACHE_DIR=.cache
REQUESTS_PER_SECOND=5

# --- Trading credentials (ONLY needed to place real orders in the live probe) ---
# Your Kalshi API key ID (a UUID from the Kalshi web app → Settings → API keys).
KALSHI_API_KEY_ID=
# Path to a file containing your RSA private key (PEM). Put the .pem OUTSIDE git
# (it matches *.pem in .gitignore). Do NOT paste the key inline here.
KALSHI_PRIVATE_KEY_PATH=./kalshi_key.pem

# --- Investigator (ONLY needed to run the real explain-away AI check) ---
# Anthropic API key for the Claude-backed investigator (Console → API keys).
# The dry-run pipeline uses a placeholder investigator and does NOT need this.
ANTHROPIC_API_KEY=
